# Entra Authentication Test Configuration Example
# Copy this file to .env.test and fill in your actual test credentials
# DO NOT commit .env.test to version control - it contains sensitive data

# Entra OAuth credentials for testing
# Get these from your Azure App Registration
ENTRA_CLIENT_ID=your-client-id-here
ENTRA_CLIENT_SECRET=your-client-secret-here
ENTRA_TENANT_ID=your-tenant-id-here

# Entra OAuth callback URI for testing
# Must match your app registration redirect URI
ENTRA_REDIRECT_URI=https://localhost:3000/callback

# Test database name
TEST_DATABASE_NAME=entra_test_db

# Enable integration tests (requires real credentials above)
# Set to 'true' to run tests against real Entra ID
ENABLE_INTEGRATION_TESTS=false

# Integration test credentials (only needed if ENABLE_INTEGRATION_TESTS=true)
# Set these to real values for testing with actual Entra ID
# ENTRA_TEST_USER_UPNAME=user@yourtenant.onmicrosoft.com
# ENTRA_TEST_USER_PASSWORD=your-secure-password

# Node environment
NODE_ENV=test
