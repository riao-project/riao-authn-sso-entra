# Entra SSO Configuration
# Environment variables loaded by ts-appconfig with strong typing

## Get these values from your Entra App Registration:
## https://portal.azure.com/ → App registrations → Your App

# Application (client) ID
ENTRA_CLIENT_ID=your-client-id-here

# Client secret (from Certificates & secrets)
ENTRA_CLIENT_SECRET=your-client-secret-here

# Directory (tenant) ID
ENTRA_TENANT_ID=your-tenant-id-here

# Redirect URI must match configured in App Registration
# Platform: Web → Redirect URIs
ENTRA_REDIRECT_URI=http://localhost:3000/auth/entra/callback

# Session secret (generate a random string)
SESSION_SECRET=your-random-secret-here

# Environment
NODE_ENV=development

# Server port
PORT=3000

# Database connection (example)
# DATABASE_URL=postgresql://user:password@localhost/riao_iam

